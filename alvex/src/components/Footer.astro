---
// Site footer. Shared across all pages.
import { ui, company, type Lang } from '../i18n/ui';

const { lang = 'de' as Lang } = Astro.props;
const t = ui[lang as Lang];
const f = t.footer;
// Legal pages live under /en/ for English, site root for German.
const legalBase = lang === 'en' ? '/en' : '';
---
<footer>
    <div class="container footer-grid">
        <div>
            <h3 style="color: white; margin-bottom: 1rem;">{company.name}</h3>
            <p>{f.tagline}</p>
        </div>
        <div class="footer-legal-text">
            <div class="footer-links">
                <a href={`${legalBase}/impressum`}>{f.impressum}</a>
                <a href={`${legalBase}/datenschutz`}>{f.datenschutz}</a>
            </div>
            <p><strong>{f.managingDirectorLabel}</strong> {company.managingDirector}<br>
            <strong>{f.registerCourtLabel}</strong> {company.registerCourt}<br>
            <strong>{f.vatLabel}</strong> {company.vatId}</p>

            <p style="font-size: 0.8rem; color: #64748b;">
                <strong>{f.authorityLabel}</strong><br>
                {f.authorityText}<br>
                {f.authoritySupervisor}
            </p>
        </div>
    </div>
    <div class="container footer-bottom">
        <p>{f.rights}</p>
        <p>{f.compliance}</p>
    </div>
</footer>
