---
import Base from '../../layouts/Base.astro';
---
<Base
    title="Thank You | ALVEX Handel GmbH"
    description="Your request has been submitted successfully."
    lang="en"
    noindex={true}
    switchHref="/danke/"
>
    <main class="section legal-page">
        <div class="container" style="text-align: center;">
            <h1>Thank you for your enquiry</h1>
            <p class="legal-intro" style="margin-left: auto; margin-right: auto;">
                Your message has been submitted successfully. Our sales team in Frankfurt am Main
                will get back to you shortly.
            </p>
            <p><a class="btn" href="/en/">Back to homepage</a></p>
        </div>
    </main>
</Base>
