---
import Base from '../../layouts/Base.astro';

const alternates = [
    { lang: 'de', path: '/impressum/' },
    { lang: 'en', path: '/en/impressum/' },
];
---
<Base
    lang="en"
    title="Legal Notice | ALVEX Handel GmbH"
    description="Legal notice (Impressum) of ALVEX Handel GmbH, Frankfurt am Main – company details in accordance with Section 5 of the German Digital Services Act (DDG)."
    alternates={alternates}
    switchHref="/impressum/"
>
    <main class="section legal-page">
        <div class="container">
            <h1>Legal Notice</h1>
            <p class="legal-note">
                This English text is a courtesy translation. The legally binding version of this legal notice
                is the <a href="/impressum/">German version</a>.
            </p>

            <p>
                ALVEX Handel GmbH<br>
                Steinweg 3<br>
                60313 Frankfurt am Main, Germany
            </p>

            <p>
                Commercial register: 142640<br>
                Registration court: Amtsgericht Frankfurt am Main (Frankfurt am Main Local Court)
            </p>

            <p>
                <strong>Represented by:</strong><br>
                Mehmet Selik Celikkiran
            </p>

            <h2>Contact</h2>
            <p>
                Phone: 069 95057680<br>
                Fax: 069 95057689<br>
                E-mail: <a href="mailto:info@alvexhandel.com">info@alvexhandel.com</a>
            </p>

            <h2>VAT ID</h2>
            <p>
                VAT identification number pursuant to Section 27 a of the German VAT Act (UStG):<br>
                DE463817322
            </p>

            <h2>Professional title and professional regulations</h2>
            <p>
                Professional title:<br>
                Import and export as well as national and international trade in goods of all kinds, wholesale and retail trade.
            </p>
            <p>
                Granted in:<br>
                Hesse, Germany
            </p>

            <h2>Consumer dispute resolution / universal arbitration board</h2>
            <p>
                We are neither willing nor obliged to participate in dispute resolution proceedings before a
                consumer arbitration board.
            </p>

            <h2>Central point of contact under the Digital Services Act – DSA (Regulation (EU) 2022/2065)</h2>
            <p>
                You can reach our central point of contact for users and authorities pursuant to Art. 11, 12 DSA
                as follows:
            </p>
            <p>
                E-mail: <a href="mailto:info@immoservice-cm.de">info@immoservice-cm.de</a><br>
                Phone: 069 95057680
            </p>
            <p>
                Other means of contact:<br>
                CM Immobilien Service GmbH, Steinweg 3, 60313 Frankfurt am Main
            </p>
            <p>
                The languages available for contact are: German, English.
            </p>

            <p class="legal-source">
                Source: <a href="https://www.e-recht24.de" target="_blank" rel="noopener">e-recht24.de</a>
            </p>
        </div>
    </main>
</Base>
