---
import Base from '../../layouts/Base.astro';

const alternates = [
    { lang: 'de', path: '/' },
    { lang: 'en', path: '/en/' },
];
---
<Base navHero={true} lang="en" alternates={alternates}>
    <section class="hero" id="home">
        <div class="container hero-inner">
            <img
                class="hero-logo"
                src="/assets/img/Logo_Main_Hero.svg"
                alt="ALVEX Handel GmbH – International supplier of high-quality sodium bicarbonate"
                width="520"
                height="200"
            />
            <h1>International supplier of high-quality sodium bicarbonate</h1>

            <div class="hero-video" id="heroVideo">
                <div class="video-wrapper">
                    <video id="heroVideoEl" controls playsinline preload="metadata">
                        <source src="/assets/video/Alvex%20Trailer%20V.4%20EN%20(DE-UT).mp4" type="video/mp4">
                    </video>
                </div>
            </div>

            <div class="hero-actions">
                <a href="/en/#kontakt" class="btn">Request a quote</a>
                <a href="/en/specifications/" class="btn btn-outline">View specifications</a>
            </div>
        </div>
    </section>

    <section class="section" id="ueber-uns">
        <div class="container about-grid">
            <div class="about-content">
                <h2>About us</h2>
                <p>ALVEX is an internationally oriented trading company based in Frankfurt am Main, specialised in the distribution of high-quality sodium bicarbonate for a wide range of industrial applications.</p>
                <p>Together with our production partners, we combine high quality standards with reliable supply capability, flexible logistics solutions and professional handling in international trade.</p>
                <p>Clear structures, short communication channels and a high standard of quality form the basis of our daily business.</p>
                <p>ALVEX stands for reliability, continuity and long-term partnerships – with the aim of offering our customers not just a product, but a sustainable and professional solution.</p>
            </div>
            <div class="about-image">
                <img src="/assets/img/Weltkarte_Homepage.jpeg" alt="ALVEX – worldwide trade and supply connections in international sodium bicarbonate trade" loading="lazy" width="1536" height="1024">
            </div>
        </div>
    </section>

    <section class="section section-bg" id="branchen">
        <div class="container">
            <div class="text-center">
                <h2>Our Industries</h2>
                <p>Versatile applications worldwide</p>
            </div>

            <div class="app-grid">
                <a href="#kontakt" class="app-card">
                    <img class="app-img" src="/assets/img/Food%20Industry.svg" alt="Sodium bicarbonate for the food industry" loading="lazy" width="400" height="400">
                    <div class="app-body">
                        <h3>Food Industry</h3>
                        <p>Sodium bicarbonate is a versatile raw material for the food industry, improving quality, texture and stability – as a leavening agent in baked goods, for pH regulation and to support processing operations. Its high purity and consistent quality make it a reliable choice for manufacturers who depend on reproducible results, product safety and stable production standards.</p>
                    </div>
                </a>

                <a href="#kontakt" class="app-card">
                    <img class="app-img" src="/assets/img/Pharmaceuticals.svg" alt="Sodium bicarbonate for the pharmaceutical industry" loading="lazy" width="400" height="400">
                    <div class="app-body">
                        <h3>Pharmaceuticals</h3>
                        <p>In the pharmaceutical industry, sodium bicarbonate serves as a high-grade active and excipient ingredient – for example in medicines, effervescent products, buffer systems and pharmaceutical preparations where purity, safety and consistent quality are decisive. Thanks to its high specification, it meets the requirements of sensitive manufacturing processes.</p>
                    </div>
                </a>

                <a href="#kontakt" class="app-card">
                    <img class="app-img" src="/assets/img/Cosmetics.svg" alt="Sodium bicarbonate for cosmetic products" loading="lazy" width="400" height="400">
                    <div class="app-body">
                        <h3>Cosmetics</h3>
                        <p>Sodium bicarbonate is a proven ingredient in cosmetic and personal-care products. It is used in formulations for cleansing, odour neutralisation, pH regulation and gentle care – from deodorants and dental care to bath additives and scrubs. Its versatility and high quality make it a reliable basis for modern beauty and personal-care concepts.</p>
                    </div>
                </a>

                <a href="#kontakt" class="app-card">
                    <img class="app-img" src="/assets/img/Cleaning%20Products.svg" alt="Sodium bicarbonate for cleaning products" loading="lazy" width="400" height="400">
                    <div class="app-body">
                        <h3>Cleaning Products</h3>
                        <p>Sodium bicarbonate is a proven component of many cleaning products. It neutralises odours, supports cleaning performance and acts as a functional ingredient in household and industrial cleaners. Its high quality and flexible range of uses make it a reliable basis for effective, user-friendly cleaning solutions.</p>
                    </div>
                </a>

                <a href="#kontakt" class="app-card">
                    <img class="app-img" src="/assets/img/Industrial%20Applications.svg" alt="Sodium bicarbonate for industrial applications" loading="lazy" width="400" height="400">
                    <div class="app-body">
                        <h3>Industry</h3>
                        <p>Sodium bicarbonate is used in numerous industrial applications and stands out for its functional versatility – in chemical processes, technical cleaning applications and specific production operations. Its high purity, consistent quality and broad usability make it a valuable raw material for efficient and safe process solutions.</p>
                    </div>
                </a>

                <a href="#kontakt" class="app-card">
                    <img class="app-img" src="/assets/img/Water%20Treatment.svg" alt="Sodium bicarbonate for water treatment" loading="lazy" width="400" height="400">
                    <div class="app-body">
                        <h3>Water Treatment</h3>
                        <p>In water treatment, sodium bicarbonate stabilises the pH value, regulates water chemistry and supports controlled water quality. It helps reduce the risk of corrosion and adjust alkalinity precisely. Its reliable quality suits industrial water treatment systems as well as applications that require precise control of water parameters.</p>
                    </div>
                </a>

                <a href="#kontakt" class="app-card">
                    <img class="app-img" src="/assets/img/Animal%20Feed.svg" alt="Sodium bicarbonate for animal nutrition" loading="lazy" width="400" height="400">
                    <div class="app-body">
                        <h3>Animal Nutrition</h3>
                        <p>In the animal feed industry, sodium bicarbonate is used as a functional additive to support feed concepts for livestock. It plays a particular role in ration formulation and contributes to the stability of feeding systems. Its consistent quality and safe processing make it a reliable choice for balanced, performance-oriented feeding solutions.</p>
                    </div>
                </a>

                <a href="#kontakt" class="app-card">
                    <img class="app-img" src="/assets/img/Environmental%20Solutions.svg" alt="Sodium bicarbonate for environmental applications and flue-gas cleaning" loading="lazy" width="400" height="400">
                    <div class="app-body">
                        <h3>Environmental Applications</h3>
                        <p>Sodium bicarbonate plays an important role in environmentally oriented applications and sustainable process solutions – wherever emission reduction, resource efficiency and more environmentally friendly production methods are the focus. In this way, it combines technical requirements with a responsible approach to the environment and resources.</p>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <section class="specs-banner">
        <div class="container specs-banner-inner">
            <div class="specs-banner-text">
                <h2>Full Product Specifications</h2>
                <p>Chemical and physical properties for food, feed and technical grade – at a glance.</p>
            </div>
            <a href="/en/specifications/" class="btn specs-banner-btn">View specifications</a>
        </div>
    </section>

    <section class="section" id="team">
        <div class="container">
            <div class="text-center">
                <h2>Our Team</h2>
                <p>Central management in Germany and reliable operational execution.</p>
            </div>

            <div class="team-section">
                <div class="team-grid-tr">
                    {/* Portrait Cihad – add card once the photo is available */}
                    <div class="member-card">
                        <img src="/assets/img/Portrait_Tugrul.jpeg" alt="Tuğrul – ALVEX operations team" class="member-img" loading="lazy" width="1024" height="1536">
                    </div>
                </div>
                <div class="team-text-block">
                    <h3>Operations Team</h3>
                    <h4>Operational execution &amp; project handling</h4>
                    <p>Our operations team is responsible for operational execution and reliably supports projects on site.</p>
                </div>
            </div>

            <div class="team-section" style="margin-top: 4rem;">
                <div class="team-grid-de">
                    <div class="member-card">
                        <img src="/assets/img/Mehmet_in_Buero.jpeg" alt="Mehmet Selik Celikkiran – ALVEX management" class="member-img" loading="lazy" width="600" height="750">
                    </div>
                    <div class="member-card">
                        <img src="/assets/img/Team_Meeting.jpeg" alt="ALVEX Germany team in a meeting" class="member-img" loading="lazy" width="800" height="600">
                    </div>
                </div>
                <div class="team-text-block">
                    <h3>Germany Team</h3>
                    <h4>Central management, project coordination &amp; logistics</h4>
                    <p>Our Germany team is the central hub for organisation, planning and operational coordination.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="kontakt">
        <div class="container contact-grid">
            <div class="contact-info">
                <h2>Request a Quote</h2>
                <p>Contact our sales department in Frankfurt am Main directly for a tailored, volume-tiered fixed-price offer including freight calculation.</p>

                <div class="info-block">
                    <span>Frankfurt Headquarters:</span>
                    <p>ALVEX Handel GmbH</p>
                    <p>Steinweg 3</p>
                    <p>60313 Frankfurt am Main</p>
                </div>
                <div class="info-block">
                    <span>Direct contact:</span>
                    <p>Phone: +49 (0) 69 9505 7680</p>
                    <p>E-mail: info@alvexhandel.com</p>
                </div>
            </div>

            <div>
                <form class="contact-form" action="/contact.php" method="POST">
                    <input type="hidden" name="lang" value="en">
                    <div class="hp-field" aria-hidden="true">
                        <label for="website">Please leave this field empty</label>
                        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="name">Contact Name *</label>
                            <input type="text" id="name" name="name" required="" autocomplete="name">
                        </div>
                        <div class="form-group">
                            <label for="firma">Company</label>
                            <input type="text" id="firma" name="firma" autocomplete="organization">
                        </div>
                        <div class="form-group">
                            <label for="email">E-mail Address *</label>
                            <input type="email" id="email" name="email" required="" autocomplete="email">
                        </div>
                        <div class="form-group">
                            <label for="telefon">Phone</label>
                            <input type="tel" id="telefon" name="telefon" autocomplete="tel">
                        </div>
                        <div class="form-group form-group-full">
                            <label for="nachricht">Specific requirements / Message</label>
                            <textarea id="nachricht" name="nachricht" rows="4" placeholder="Please specify the desired packaging (silo, big bags, sacks) and delivery periods..."></textarea>
                        </div>
                    </div>

                    <div class="checkbox-group">
                        <input type="checkbox" id="datenschutz" name="datenschutz" required="">
                        <label for="datenschutz">I have read the <a href="/en/datenschutz/">Privacy Policy</a> and agree that my data may be processed for the purpose of contacting me. *</label>
                    </div>

                    <button type="submit" class="btn" style="width: 100%;">Send request</button>
                </form>
            </div>
        </div>
    </section>

    <div class="trust-bar">
        <div class="container trust-grid">
            <div class="trust-item">Worldwide Supply</div>
            <div class="trust-item">Industrial Expertise</div>
            <div class="trust-item">Flexible Packaging</div>
            <div class="trust-item">Reliable Partner</div>
        </div>
    </div>
</Base>
