---
import Base from '../layouts/Base.astro';
---
<Base
    title="Vielen Dank | ALVEX Handel GmbH"
    description="Ihre Anfrage wurde erfolgreich übermittelt."
    noindex={true}
    switchHref="/en/thank-you/"
>
    <main class="section legal-page">
        <div class="container" style="text-align: center;">
            <h1>Vielen Dank für Ihre Anfrage</h1>
            <p class="legal-intro" style="margin-left: auto; margin-right: auto;">
                Ihre Nachricht wurde erfolgreich übermittelt. Unser Vertriebsteam in Frankfurt
                am Main meldet sich zeitnah bei Ihnen.
            </p>
            <p><a class="btn" href="/">Zurück zur Startseite</a></p>
        </div>
    </main>
</Base>
