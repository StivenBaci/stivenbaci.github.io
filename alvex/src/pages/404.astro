---
import Base from '../layouts/Base.astro';
---
<Base
    title="Seite nicht gefunden (404) | ALVEX Handel GmbH"
    description="Die aufgerufene Seite wurde nicht gefunden."
    noindex={true}
>
    <main class="section legal-page">
        <div class="container" style="text-align: center;">
            <h1>404 – Seite nicht gefunden</h1>
            <p class="legal-intro" style="margin-left: auto; margin-right: auto;">
                Die von Ihnen aufgerufene Seite existiert nicht oder wurde verschoben.<br>
                This page could not be found.
            </p>
            <p>
                <a class="btn" href="/">Zur Startseite</a>
                <a class="btn btn-dark" href="/en/">English homepage</a>
            </p>
        </div>
    </main>
</Base>
