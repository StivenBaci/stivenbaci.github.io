    <section class="section" id="kontakt">
        <div class="container contact-grid">
            <div class="contact-info">
                <h2>Angebotsanfrage</h2>
                <p>Wenden Sie sich direkt an unsere Verkaufsabteilung in Frankfurt am Main für ein maßgeschneidertes, volumengestaffeltes Festpreisangebot inklusive Frachtkostenberechnung.</p>

                <div class="info-block">
                    <span>Zentrale Frankfurt:</span>
                    <p>ALVEX Handel GmbH</p>
                    <p>Mainzer Landstraße / City-Lage</p>
                    <p>60313 Frankfurt am Main</p>
                </div>
                <div class="info-block">
                    <span>Direktkontakt:</span>
                    <p>Tel: +49 (0) 69 9505 7680</p>
                    <p>E-Mail: info@alvexhandel.com</p>
                </div>
            </div>

            <div>
                <form class="contact-form" action="#" method="POST" onsubmit="alert('Dies ist ein Funktionsprototyp. Es wurden keine Daten übertragen.'); return false;">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="name">Ansprechpartner Name *</label>
                            <input type="text" id="name" required="" autocomplete="name">
                        </div>
                        <div class="form-group">
                            <label for="firma">Firmenname</label>
                            <input type="text" id="firma" autocomplete="organization">
                        </div>
                        <div class="form-group">
                            <label for="email">E-Mail-Adresse *</label>
                            <input type="email" id="email" required="" autocomplete="email">
                        </div>
                        <div class="form-group">
                            <label for="telefon">Telefonnummer</label>
                            <input type="tel" id="telefon" autocomplete="tel">
                        </div>
                        <div class="form-group form-group-full">
                            <label for="nachricht">Spezifische Anforderungen / Nachricht</label>
                            <textarea id="nachricht" rows="4" placeholder="Spezifizieren Sie hier gewünschte Verpackungsart (Silo, Big Bags, Sackware) sowie Lieferzeiträume..."></textarea>
                        </div>
                    </div>

                    <div class="checkbox-group">
                        <input type="checkbox" id="datenschutz" required="">
                        <label for="datenschutz">Ich habe die Datenschutzerklärung zur Kenntnis genommen und stimme zu, dass meine Angaben zur Kontaktaufnahme verarbeitet werden. *</label>
                    </div>

                    <button type="submit" class="btn" style="width: 100%;">Anfrage senden</button>
                </form>
            </div>
        </div>
    </section>

    <div class="trust-bar">
        <div class="container trust-grid">
            <div class="trust-item">Worldwide Supply</div>
            <div class="trust-item">Industrial Expertise</div>
            <div class="trust-item">Flexible Packaging</div>
            <div class="trust-item">Reliable Partner</div>
        </div>
    </div>
</Base>
