---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, contact, legal } from '../data/site';
import { u, isPreview } from '../lib/url';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} | ${site.name} Frankfurt`
  : `${site.name} Frankfurt am Main | Bausanierung, Fassade & Innenausbau`;

// Origin kommt aus astro.config (Produktion: eigene Domain, Vorschau: github.io)
const origin = (Astro.site ?? new URL(site.url)).origin;
const siteBase = new URL(u('/'), origin).href.replace(/\/$/, '');
const canonical = new URL(path, origin).href;
const ogImage = new URL(u('/assets/logo-dark.png'), origin).href;

// In der Vorschau grundsätzlich nicht indexieren lassen
const robotsNoindex = noindex || isPreview;

// JSON-LD: LocalBusiness (HomeAndConstructionBusiness)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${siteBase}/#business`,
  name: site.name,
  legalName: site.legalName,
  url: siteBase,
  image: ogImage,
  logo: ogImage,
  description: site.description,
  telephone: contact.phone,
  email: contact.email,
  foundingDate: String(site.founded),
  areaServed: [
    { '@type': 'City', name: 'Frankfurt am Main' },
    { '@type': 'AdministrativeArea', name: 'Rhein-Main-Gebiet' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.street,
    postalCode: contact.zip,
    addressLocality: 'Frankfurt am Main',
    addressRegion: 'Hessen',
    addressCountry: 'DE',
  },
  openingHours: 'Mo-Fr 08:00-17:00',
  priceRange: '€€',
  knowsAbout: [
    'Bausanierung',
    'Altbausanierung',
    'Fassadensanierung',
    'Innenausbau',
    'Renovierung',
    'Abdichtung',
    'Betonsanierung',
  ],
  slogan: site.tagline,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsNoindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}

    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#14263f" />
    <meta name="format-detection" content="telephone=yes" />

    <!-- Geo / lokale SEO -->
    <meta name="geo.region" content="DE-HE" />
    <meta name="geo.placename" content="Frankfurt am Main" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('/assets/logo-dark.png')} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#hauptinhalt" class="skip-link">Zum Inhalt springen</a>
    <Header />
    <main id="hauptinhalt">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Sanftes Einblenden beim Scrollen (Progressive Enhancement)
      (function () {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach((e) => e.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--navy-800);
    color: #fff;
    padding: 0.75rem 1.25rem;
    z-index: 1000;
    border-radius: 0 0 6px 0;
  }
  .skip-link:focus { left: 0; color: #fff; }
</style>
