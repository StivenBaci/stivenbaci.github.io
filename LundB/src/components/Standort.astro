---
import { contact } from '../data/site';

// Google-Maps-Embed ohne API-Key. Wird erst nach Klick (Einwilligung) geladen,
// damit vor Zustimmung keine Daten an Google übertragen werden (DSGVO).
const embedSrc =
  'https://maps.google.com/maps?q=' +
  encodeURIComponent(contact.mapQuery) +
  '&z=15&hl=de&output=embed';
import { u } from '../lib/url';
---

<section class="section" id="standort" aria-labelledby="standort-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Standort &amp; Anfahrt</p>
      <h2 id="standort-title">Zentral in Frankfurt-Sachsenhausen</h2>
      <p>
        Sie finden uns an der Darmstädter Landstraße im Süden Frankfurts – kurze Wege
        ins gesamte Rhein-Main-Gebiet. Kommen Sie gern nach Absprache vorbei.
      </p>
    </div>

    <div class="standort-grid reveal">
      <div class="standort-info">
        <h3>L&amp;B Bausanierung</h3>
        <address>
          {contact.street}<br />
          {contact.zip} {contact.cityLine}
        </address>

        <dl class="standort-meta">
          <div>
            <dt>Öffnungszeiten</dt>
            <dd>{contact.hours}</dd>
          </div>
          <div>
            <dt>Telefon</dt>
            <dd><a href={contact.phoneHref}>{contact.phone}</a></dd>
          </div>
        </dl>

        <a href={contact.mapsLink} class="btn btn--primary" target="_blank" rel="noopener">
          Route planen
        </a>
      </div>

      <div class="standort-map">
        <div class="map-consent" id="mapConsent" data-embed={embedSrc}>
          <div class="map-consent-inner">
            <span class="map-pin" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <p class="map-title">Karte von Google Maps</p>
            <p class="map-note">
              Beim Laden der Karte werden Daten an Google übertragen. Näheres in der
              <a href={u('/datenschutz')}>Datenschutzerklärung</a>.
            </p>
            <button type="button" class="btn btn--gold" id="mapLoad">Karte laden</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .standort-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  .standort-info {
    background: var(--bg-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2rem);
    display: flex;
    flex-direction: column;
  }
  .standort-info h3 { margin-bottom: 0.4rem; }
  .standort-info address {
    font-style: normal;
    color: var(--slate);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .standort-meta {
    margin: 0 0 1.5rem;
    display: grid;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .standort-meta dt {
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.15rem;
  }
  .standort-meta dd { margin: 0; font-weight: 600; color: var(--navy-800); }
  .standort-info .btn { margin-top: auto; align-self: flex-start; }

  .standort-map {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    min-height: 340px;
    box-shadow: var(--shadow-sm);
  }
  .map-consent {
    height: 100%;
    min-height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.5rem;
    background:
      radial-gradient(600px 300px at 50% 0%, rgba(182,149,93,0.12), transparent 65%),
      linear-gradient(155deg, #14263f, #0e1c30);
    color: #cdd8e6;
  }
  .map-consent-inner { max-width: 340px; }
  .map-pin {
    display: inline-flex;
    width: 52px; height: 52px;
    align-items: center; justify-content: center;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    color: var(--gold-300);
    margin-bottom: 1rem;
  }
  .map-pin svg { width: 26px; height: 26px; }
  .map-title { color: #fff; font-weight: 700; margin-bottom: 0.4rem; font-size: 1.1rem; }
  .map-note { font-size: 0.88rem; color: #9fb0c4; margin-bottom: 1.25rem; }
  .map-note a { color: var(--gold-300); text-decoration: underline; }
  .standort-map iframe { display: block; width: 100%; height: 100%; min-height: 340px; border: 0; }

  @media (min-width: 900px) {
    .standort-grid { grid-template-columns: 0.85fr 1.15fr; gap: 2rem; }
  }
</style>

<script is:inline>
  (function () {
    var box = document.getElementById('mapConsent');
    var btn = document.getElementById('mapLoad');
    if (!box || !btn) return;
    btn.addEventListener('click', function () {
      var src = box.getAttribute('data-embed');
      var iframe = document.createElement('iframe');
      iframe.setAttribute('src', src);
      iframe.setAttribute('title', 'Standort L&B Bausanierung auf Google Maps');
      iframe.setAttribute('loading', 'lazy');
      iframe.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
      iframe.setAttribute('allowfullscreen', '');
      box.replaceWith(iframe);
    });
  })();
</script>
