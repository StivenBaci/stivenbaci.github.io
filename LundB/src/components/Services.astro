---
import { services } from '../data/site';

const icons: Record<string, string> = {
  building: '<path d="M3 21h18M6 21V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v16M18 21V10l-4-3M9 7h2M9 11h2M9 15h2"/>',
  interior: '<path d="M3 21h18M5 21V8l7-4 7 4v13M9 21v-6h6v6M4 8l8-4 8 4"/>',
  facade: '<path d="M4 21V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v15M4 21h16M8 8h.01M12 8h.01M16 8h.01M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3zM9 12l2 2 4-4"/>',
  concrete: '<path d="M3 8h18M3 8l2-4h14l2 4M3 8v12h18V8M8 8v12M13 8v12M3 14h18"/>',
  trowel: '<path d="M3 3l7 7M6.5 6.5L2 15l4 4 8.5-4.5M14 10l7-7-4 1-4 4z"/>',
};
---

<section class="section section--warm" id="leistungen" aria-labelledby="leistungen-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Dienstleistungen</p>
      <h2 id="leistungen-title">Alles aus einer Hand – von der Substanz bis zum Anstrich</h2>
      <p>
        Als Full-Service-Fachbetrieb decken wir das gesamte Spektrum der
        Bausanierung ab. Ein Ansprechpartner, klare Abläufe und Gewerke, die
        sauber ineinandergreifen – so bleibt Ihr Projekt planbar.
      </p>
    </div>

    <div class="services-grid">
      {services.map((s) => (
        <article class="service-card reveal">
          <span class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
          </span>
          <h3>{s.title}</h3>
          <p>{s.teaser}</p>
          <ul>
            {s.points.map((p) => <li>{p}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .service-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.6rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--gold);
  }
  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px; height: 54px;
    border-radius: 12px;
    background: var(--navy-800);
    color: var(--gold-300);
    margin-bottom: 1.1rem;
  }
  .service-icon svg { width: 28px; height: 28px; }
  .service-card h3 { margin-bottom: 0.5rem; }
  .service-card p { color: var(--slate); margin-bottom: 1rem; }
  .service-card ul {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }
  .service-card li {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--navy-700);
    background: var(--bg-warm-2);
    padding: 0.28rem 0.7rem;
    border-radius: 100px;
  }

  @media (min-width: 620px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .services-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  }
</style>
