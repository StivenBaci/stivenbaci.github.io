---
import { contact } from '../data/site';
import { u } from '../lib/url';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="eyebrow eyebrow--light">Frankfurt am Main · seit über 30 Jahren</p>
      <h1 id="hero-title">
        Bausanierung, die <span class="hl">Bestand</span> hat.
      </h1>
      <p class="hero-lead">
        Vom Altbau bis zur Fassade: L&amp;B Bausanierung bringt Gebäude im
        Rhein-Main-Gebiet zuverlässig, termintreu und in echter Handwerks­qualität
        wieder in Form. Ein eingetragener Fachbetrieb, drei Jahrzehnte Erfahrung.
      </p>
      <div class="hero-actions">
        <a href={u('/#kontakt')} class="btn btn--gold">Kostenloses Angebot</a>
        <a href={u('/#leistungen')} class="btn btn--outline-light">Unsere Leistungen</a>
      </div>
      <ul class="hero-trust">
        <li><strong>30+</strong> Jahre Erfahrung</li>
        <li><strong>Meister­betrieb</strong> &amp; eingetragen</li>
        <li><strong>Festpreis</strong> &amp; Termintreue</li>
      </ul>
    </div>
  </div>
  <a href={contact.phoneHref} class="hero-call" aria-label="Jetzt anrufen">
    <span>Direkt anrufen</span> {contact.phone}
  </a>
</section>

<style>
  .hero {
    position: relative;
    color: #fff;
    overflow: hidden;
    background: var(--navy-900);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(1100px 500px at 80% -10%, rgba(182, 149, 93, 0.22), transparent 60%),
      linear-gradient(160deg, #14263f 0%, #0e1c30 55%, #0b1626 100%);
  }
  /* dezentes Blaupausen-Raster als Bild-Ersatz */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,.7), transparent 75%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,.7), transparent 75%);
  }
  .hero-inner {
    position: relative;
    padding-block: clamp(4rem, 12vw, 8rem);
  }
  .hero-content { max-width: 700px; }
  .eyebrow--light { color: var(--gold-300); }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.3rem, 7vw, 4rem);
    margin-bottom: 1.1rem;
  }
  .hero h1 .hl { color: var(--gold-300); }
  .hero-lead {
    font-size: clamp(1.05rem, 2.4vw, 1.28rem);
    color: #c6d1df;
    max-width: 60ch;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .hero-actions .btn { flex: 1 1 auto; min-width: 210px; }
  .hero-trust {
    list-style: none;
    margin: 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .hero-trust li { color: #aebbcd; font-size: 0.98rem; }
  .hero-trust strong { color: #fff; font-weight: 700; }

  .hero-call {
    display: none;
  }

  @media (min-width: 560px) {
    .hero-actions .btn { flex: 0 0 auto; }
    .hero-trust { grid-template-columns: repeat(3, auto); gap: 2rem; justify-content: start; }
  }

  /* Sticky Anruf-Button nur auf kleinen Screens */
  @media (max-width: 900px) {
    .hero-call {
      position: fixed;
      left: 12px; right: 12px; bottom: 12px;
      z-index: 90;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: var(--gold);
      color: var(--navy-900);
      font-weight: 700;
      padding: 0.9rem 1rem;
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
    }
    .hero-call span { font-weight: 600; }
    .hero-call span::after { content: ' ·'; }
  }
</style>
